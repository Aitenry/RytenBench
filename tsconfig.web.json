{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "src/renderer/src/env.d.ts",
    "src/renderer/src/**/*",
    "src/renderer/src/**/*.tsx",
    "src/renderer/src/types/**/*",
    "src/main/types/**/*",
    "src/plugins/**/*",
    "src/shared/**/*",
    "src/preload/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "out",
    "dist",
    "src/plugins/**/main/**"
  ],
  "compilerOptions": {
    "composite": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@renderer/*": [
        "src/renderer/src/*"
      ],
      "@plugins/*": [
        "src/plugins/*"
      ],
      "@shared/*": [
        "src/shared/*"
      ]
    }
  }
}

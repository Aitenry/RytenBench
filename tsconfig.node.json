{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "electron.vite.config.*",
    "src/main/**/*",
    "src/preload/**/*",
    "src/plugins/**/*",
    "src/shared/**/*"
  ],
  "exclude": [
    "node_modules",
    "out",
    "dist",
    "src/plugins/**/renderer/**",
    "src/plugins/**/locales/**"
  ],
  "compilerOptions": {
    "composite": true,
    "types": ["electron-vite/node"],
    "baseUrl": ".",
    "paths": {
      "@plugins/*": ["src/plugins/*"],
      "@shared/*": ["src/shared/*"]
    }
  }
}
